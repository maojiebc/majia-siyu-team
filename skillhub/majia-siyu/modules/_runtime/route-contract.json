  "routes": {
    "conversation_script": {
      "reason": "请求的是欢迎、破冰或答疑话术，走一对一承接执行层。",
      "skill": "siyu-huashu",
      "target_type": "bundled"
    },
    "diagnosis": {
      "reason": "请求包含结果异常或因果疑问，先验证问题是否成立。",
      "skill": "siyu-wenzhen",
      "target_type": "bundled"
    },
    "group_campaign": {
      "reason": "请求的是群发或社群推送，走栏目与承接脚本执行层。",
      "skill": "siyu-qunfa",
      "target_type": "bundled"
    },
    "market_research": {
      "reason": "请求涉及厂商、产品、价格或市场动态，先实时检索并生成证据快照。",
      "skill": "siyu-market-research",
      "target_type": "bundled"
    },
    "membership_data": {
      "reason": "请求涉及会员指标、字段、SQL 或人群圈选，转交会员数据能力处理。",
      "skill": "majia-huiyuan",
      "target_type": "external"
    },
    "moments_copy": {
      "reason": "请求的是朋友圈内容生产，走执行层并做生成前合规检查。",
      "skill": "siyu-pyq",
      "target_type": "bundled"
    },
    "report": {
      "reason": "请求是汇总交付物，进入报告生成与合规扫描。",
      "skill": "siyu-report",
      "target_type": "bundled"
    },
    "restore_memory": {
      "reason": "请求是恢复上次结论，读取本地客户档案。",
      "skill": "siyu-restore",
      "target_type": "bundled"
    },
    "save_memory": {
      "reason": "请求是保存当前结论，进入本地客户档案。",
      "skill": "siyu-save",
      "target_type": "bundled"
    },
    "strategy_review": {
      "reason": "请求涉及整盘结构，进入四位专家分头评审和总协调收口。",
      "skill": "siyu-onboard",
      "target_type": "bundled"
    },
    "unknown": {
      "reason": "当前信息不足以安全选择执行能力，由入口只补问一个关键问题。",
      "skill": "majia-siyu",
      "target_type": "bundled"
    },
    "update": {
      "reason": "请求更新已安装的私域专家团，进入专用版本检查与安装流程。",
      "skill": "siyu-update",
      "target_type": "bundled"
    }
  },
  "stages": {
    "cold": {
      "focus": "先解决『加得上人 + 加进来不流失』：钩子、承接、第一周 SOP。",
      "label": "冷启动（0 起步 / 有微信没体系）"
    },
    "growth": {
      "focus": "先解决『分层提效 + 复购』：标签体系、自动化 SOP、复购召回。",
      "label": "扩张（有体系要提效）"
    },
    "mature": {
      "focus": "先解决『规模化裂变 + 会员体系』：合规裂变机制、会员等级、案例复制。",
      "label": "成熟（要规模化裂变）"
    }
  },
