{"schema_version":"2.0","id":"ka_4b97123fdd7d0998","statement":"站内活跃、站内休眠、站外已用过同类的、站外从未用过的——目标不同，动作不能共用一套。","type":"method","topics":["repurchase_recall","growth_l0","用户增长"],"skills":["siyu-wenzhen","reactivation-playbook","siyu-qunfa"],"source":{"source_id":"src_feee0a251c80","source_type":"expert_judgment","label":"L0-通用用户增长原则.md","path":"knowledge/00-methodology/L0-通用用户增长原则.md","locator":"L0-05","observed_at":"2026-08-06"},"scope":{"visibility":"public","client_id":"","industry":"","subindustry":"","business_model":"","channels":[],"lifecycle_stages":[],"roles":[],"scenarios":["user_growth","repurchase_recall"]},"applicability":{"preconditions":["依据：高 ROI 增长四步中的站内活跃/休眠、站外存量/增量分策。","业态：通用（L0）"],"recommended_action":["至少四格策略表；禁止「全员同一条群发/同一张券」。"],"metrics":[{"name":"观察窗复购率","definition":"观察窗内再次消费人数除以符合观察条件人数","time_window":"按品类复购周期设定"}],"failure_modes":["用召回券去砸从未接触过你的人，或用拉新钩子去烦老客。"],"counterexamples":["缺少可验证的前置数据时，应先补数而不是直接套用"]},"quality":{"evidence_grade":"C1","confidence":"medium","review_status":"approved","reviewer":"maojiebc","reviewed_at":"2026-08-06"},"lifecycle":{"valid_from":"2026-08-06","valid_until":null,"supersedes":[],"contradicts":[]},"privacy":{"contains_pii":false,"contains_client_secret":false,"exportable":true}}
